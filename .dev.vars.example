# Copy to .dev.vars for local development. Never commit credentials.
PUBLIC_URL="http://localhost:8787"
GOOGLE_CLIENT_ID="replace-with-google-web-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
# Required: only these accounts may authorize this MCP. Empty denies all access.
ALLOWED_EMAILS="replace-with-your-classroom-email"
