{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-mcp-25im0047",
  "account_id": "f38e0773ca8b5518385378f84c9497fb",
  "main": "src/index.ts",
  "minify": true,
  "assets": {
    "directory": "./public",
  },
