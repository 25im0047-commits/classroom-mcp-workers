{
  "name": "classroom-mcp",
  "version": "1.0.0",
  "description": "Google ClassroomのMCPサーバー",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm run check:config && wrangler deploy",
    "build": "npm run check:config && wrangler deploy --dry-run --outdir dist",
    "check:config": "node scripts/check-config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:config && wrangler deploy --dry-run --outdir dist && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:config && tsc --noEmit && wrangler deploy --dry-run --outdir dist && vitest run && prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/25im0047-commits/classroom-mcp-workers.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/25im0047-commits/classroom-mcp-workers/issues"
  },
  "homepage": "https://github.com/25im0047-commits/classroom-mcp-workers#readme",
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.1",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "miniflare": "5.20261023.1-beta",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wrangler": "4.154.0"
  }
}
